<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>LandsurvConnector</RootNamespace>
    <AssemblyName>LandsurvConnector</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>LandsurvConnector.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!--
    AutoCAD managed reference assemblies (compile-only; Private=False so they are
    NOT copied/shipped). Two resolution modes, first match wins:
      1. Installed AutoCAD/Civil 3D 2026 at C:\Program Files\Autodesk\AutoCAD 2026\
      2. Portable: drop acmgd.dll, acdbmgd.dll, accoremgd.dll into civil3d-client\lib\
         (e.g. copied from any machine with Civil 3D) — builds with no install,
         CI-friendly. The lib/*.dll files are gitignored (proprietary, large).
  -->
  <PropertyGroup>
    <AcadInstallDir Condition="Exists('C:\Program Files\Autodesk\AutoCAD 2026\acmgd.dll')">C:\Program Files\Autodesk\AutoCAD 2026\</AcadInstallDir>
    <AcadLibDir Condition="'$(AcadInstallDir)' == '' AND Exists('$(MSBuildProjectDirectory)\lib\acmgd.dll')">$(MSBuildProjectDirectory)\lib\</AcadLibDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(AcadInstallDir)' != ''">
    <Reference Include="AcMgd"><HintPath>$(AcadInstallDir)acmgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AcadInstallDir)acdbmgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AcadInstallDir)accoremgd.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(AcadInstallDir)' == '' AND '$(AcadLibDir)' != ''">
    <Reference Include="AcMgd"><HintPath>$(AcadLibDir)acmgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AcadLibDir)acdbmgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AcadLibDir)accoremgd.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <!-- Fail the build with a clear, actionable message when neither source exists. -->
  <Target Name="RequireAutoCadRefs" BeforeTargets="ResolveAssemblyReferences" Condition="'$(AcadInstallDir)' == '' AND '$(AcadLibDir)' == ''">
    <Error Text="AutoCAD reference assemblies not found. Either install Civil 3D / AutoCAD 2026, or copy acmgd.dll, acdbmgd.dll, accoremgd.dll into civil3d-client\lib\ (see civil3d-client\lib\README.md)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.Net.WebSockets.Client" Version="4.3.2" />
    <PackageReference Include="WebSocketSharp" Version="1.0.3-rc11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
